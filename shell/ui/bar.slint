import { NyxTheme } from "theme.slint";

component StatusText {
    in property <string> text;
    in property <string> font-family;
    in property <length> text-size;

    width: t.width;
    height: 100%;

    t := Text {
        text: root.text;
        color: NyxTheme.foreground;
        font-family: root.font-family;
        font-size: root.text-size;
    }

    TouchArea {
        clicked => { root.clicked(); }
    }

    callback clicked();
}

export component BarWindow inherits Window {
    in property <length> corner-radius: 0px;
    in property <length> spacing: 8px;
    in property <length> text-size: 12px;
    in property <string> font-family: "sans-serif";
    in property <string> logo: "";
    in property <string> workspaces: "1 2 3 4 5";
    in property <string> clock: "--:--";
    in property <string> status-weather: "";
    in property <string> status-audio: "";
    in property <string> status-network: "";
    in property <string> status-bluetooth: "";
    in property <string> status-battery: "";
    in property <string> status-cpu: "";

    height: 26px;
    background: NyxTheme.background;

    HorizontalLayout {
        padding-left: root.spacing;
        padding-right: root.spacing;
        spacing: root.spacing;

        Rectangle {
            width: 26px;
            height: 100%;
            border-radius: root.corner-radius;
            background: transparent;

            Text {
                text: root.logo;
                color: NyxTheme.foreground;
                font-family: root.font-family;
                font-size: root.text-size;
            }

            TouchArea {
                clicked => { root.launch(); }
            }
        }

        Text {
            text: root.workspaces;
            color: NyxTheme.foreground;
            font-family: root.font-family;
            font-size: root.text-size;
        }

        Rectangle {
            horizontal-stretch: 1;
            background: transparent;
        }

        StatusText {
            text: root.status-weather;
            font-family: root.font-family;
            text-size: root.text-size;
            clicked => { root.open-weather(); }
        }

        StatusText {
            text: root.clock;
            font-family: root.font-family;
            text-size: root.text-size;
            clicked => { root.open-clock(); }
        }

        StatusText {
            text: root.status-audio;
            font-family: root.font-family;
            text-size: root.text-size;
            clicked => { root.open-audio(); }
        }

        StatusText {
            text: root.status-network;
            font-family: root.font-family;
            text-size: root.text-size;
            clicked => { root.open-network(); }
        }

        StatusText {
            text: root.status-bluetooth;
            font-family: root.font-family;
            text-size: root.text-size;
            clicked => { root.open-network(); }
        }

        StatusText {
            text: root.status-battery;
            font-family: root.font-family;
            text-size: root.text-size;
            clicked => { root.open-power(); }
        }

        StatusText {
            text: root.status-cpu;
            font-family: root.font-family;
            text-size: root.text-size;
            clicked => { root.open-power(); }
        }
    }

    callback launch();
    callback open-weather();
    callback open-clock();
    callback open-audio();
    callback open-network();
    callback open-power();
}
